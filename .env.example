# Ollama
# 로컬 실행 시: http://localhost:11434
# Docker Compose 실행 시: http://ollama:11434 (docker-compose.yml에서 자동 설정)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.0

# Embedding
EMBEDDING_MODEL=nomic-embed-text

# ChromaDB
CHROMA_PERSIST_DIR=data/processed/chroma
CHROMA_COLLECTION=docs

# Ingestion
DATA_RAW_DIR=data/raw
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
RETRIEVER_K=4

# Scheduler (매일 자동 인제스트 실행 시각, 0~23)
INGEST_SCHEDULE_HOUR=3
